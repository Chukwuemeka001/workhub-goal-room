{
  "name": "workhub-goal-room",
  "version": "0.0.1",
  "private": false,
  "type": "module",
  "license": "Apache-2.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "eval:phase6": "node --experimental-strip-types scripts/phase6-evaluate.ts",
    "eval:phase6:conformance": "npm run eval:phase6 -- conformance --out evaluation/phase6-conformance.json",
    "qa:mobile": "node scripts/mobile-qa.mjs",
    "preview": "vite preview"
  },
  "devDependencies": {
    "@types/node": "latest",
    "typescript": "latest",
    "vite": "latest",
    "vitest": "latest"
  }
}
