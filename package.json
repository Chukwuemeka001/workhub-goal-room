{
  "name": "workhub-goal-room",
  "version": "0.0.1",
  "private": false,
  "type": "module",
  "license": "Apache-2.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "test": "npm run test:browser-resolver && vitest run --exclude qa/phase8VisualHarness.test.ts && npm run test:composition",
    "test:browser-resolver": "node --test scripts/browser-resolver.node-test.mjs",
    "test:unit": "vitest run --exclude qa/phase8VisualHarness.test.ts",
    "test:phase8-visual": "vitest run qa/phase8VisualHarness.test.ts",
    "test:composition": "node scripts/composition-production-qa.mjs",
    "test:watch": "vitest",
    "eval:phase6": "node --experimental-strip-types scripts/phase6-evaluate.ts",
    "eval:phase6:conformance": "npm run eval:phase6 -- conformance --out evaluation/phase6-conformance.json",
    "qa:mobile": "node scripts/mobile-qa.mjs",
    "qa:desktop": "node scripts/desktop-qa.mjs",
    "qa:phase8-visual": "node scripts/phase8-visual-qa.mjs",
    "test:v3": "vitest run qualification/v3Contract.test.ts qualification/v3Replay.test.ts qualification/v3Infrastructure.test.ts",
    "test:production-journey": "vitest run src/phase8Journey.test.ts",
    "qa:production-journey": "node scripts/production-journey-qa.mjs && node scripts/production-journey-receipt.mjs",
    "qa:v3:visual": "node scripts/v3-browser-qa.mjs visual",
    "qa:v3:responsive": "node scripts/v3-browser-qa.mjs responsive",
    "qa:v3:a11y": "node scripts/v3-browser-qa.mjs a11y",
    "qa:v3:hostile": "node scripts/v3-browser-qa.mjs hostile",
    "qa:v3:fixtures": "node scripts/v3-fixture-exclusion.mjs",
    "qa:v3:protected": "node scripts/v3-protected-bytes.mjs",
    "qa:v3:receipt": "node scripts/v3-receipt.mjs",
    "qa:phase5": "node scripts/phase5-validate.mjs",
    "qa:v3:native": "node --test scripts/v3-native-webmcp-proof.node-test.mjs",
    "qa:v3:all": "npm run test:v3 && npm run qa:v3:protected && npm run qa:v3:visual && npm run qa:v3:responsive && npm run qa:v3:a11y && npm run qa:v3:hostile && npm run qa:v3:fixtures && npm run qa:v3:receipt",
    "preview": "vite preview"
  },
  "devDependencies": {
    "@types/node": "latest",
    "typescript": "latest",
    "vite": "latest",
    "vitest": "latest"
  }
}
